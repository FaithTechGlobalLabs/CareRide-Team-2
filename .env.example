# Local PostgreSQL URL. For direct remote URLs, use the provider's TLS settings.
# Cloud Run's attached Cloud SQL socket uses the separate settings below.
DATABASE_URL=postgres://careride:careride@localhost:5432/careride

# Optional alias used by Vercel Postgres.
# POSTGRES_URL=

PORT=3000
JWT_SECRET=change-me

# Cloud Run + Cloud SQL for PostgreSQL (also attach this instance in Cloud Run).
# INSTANCE_CONNECTION_NAME takes priority over DATABASE_URL / POSTGRES_URL.
# INSTANCE_CONNECTION_NAME=your-project:your-region:your-instance
# POSTGRES_USER=careride
# POSTGRES_PASSWORD=inject-from-secret-manager
# POSTGRES_DB=careride
# Alternatively: POSTGRES_HOST=/cloudsql/your-project:your-region:your-instance
# Supported aliases: DB_HOST, DB_USER, DB_PASS, DB_NAME, DB_PORT.
# POSTGRES_* values take priority if both naming conventions are set.

# Pool limits apply per container. Defaults: 5 connections, 5-second connect timeout.
# DB_POOL_MAX=5
# DB_CONNECT_TIMEOUT_MS=5000

# Browser push notifications. Generate one stable pair; inject private values as secrets.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:operations@example.org
# NOTIFICATION_WORKER_TOKEN=
# Optional explicit path for the branch's existing file store (tests use a temporary path).
# CARERIDE_DATA_DIR=
