# npm security best practices
# Source: https://github.com/lirantal/npm-security-best-practices

# NOTE: These settings do not apply to global package installs through `npm install -g`

# SECURITY: do not run any lifecycle scripts (postinstall) etc
ignore-scripts=true

# SECURITY: reject git-source dependencies (git+ssh:// etc)
allow-git=none

# SECURITY: block packages newer than 21 days
min-release-age=21

# Pin all installed dependencies to their exact versions in `package.json`, to prevent npm supply chain attacks through automatically bringing in unvetted newer versions of other dependencies when installing one dependency 
save-exact=true